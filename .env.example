# Nandeesh Portfolio — Environment Configuration (Optional)
# The application functions 100% out of the box with zero external keys required.

# Optional: Google Gemini API Key for dynamic AI portfolio assistant responses
# If omitted, the assistant uses its built-in deterministic, fact-grounded knowledge engine.
VITE_GEMINI_API_KEY=

# Optional: Formspree, Resend, or custom contact webhook endpoint for contact form forwarding
# If omitted, the contact form provides immediate confirmation and opens a pre-formatted mailto client.
VITE_CONTACT_ENDPOINT=
